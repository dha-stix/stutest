# Copy to .env.local and fill in from Firebase console → Project settings → Your apps.
# All six values are required for sign-in and saving data.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Public address of the site, used in link previews, sitemap and robots.txt.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional model overrides (server-side). Defaults are in lib/ai/providers.ts.
# CLAUDE_MODEL=claude-opus-5-5
# OPENAI_MODEL=gpt-5
# GROK_MODEL=grok-4
